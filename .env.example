# ---------------------------------------------------------------
# Copie este arquivo para .env.local (desenvolvimento local) ou
# cadastre cada variável em Vercel > Project > Settings > Environment Variables.
# NÃO coloque valores reais neste arquivo.
# ---------------------------------------------------------------

# Vercel Blob (armazenamento PRIVADO de imagens).
# Preenchida automaticamente quando você conecta um Blob store Private ao projeto.
BLOB_READ_WRITE_TOKEN=

# Banco Postgres (Neon). Preenchida pela integração Neon na Vercel.
# Use a URL com sslmode=require.
DATABASE_URL=

# Credenciais do painel administrativo (escolha valores fortes e únicos).
ADMIN_USERNAME=1533
ADMIN_PASSWORD=1533

# Segredo usado para assinar a sessão do administrador.
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=
